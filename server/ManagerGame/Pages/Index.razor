@page "/"
@using ManagerGame.Core
@using ManagerGame.Services
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject ApplicationDbContext DbContext
@inject NavigationManager NavigationManager
@inject CurrentManagerService CurrentManager
@inject ISnackbar Snackbar
@inject IHostEnvironment Environment

<PageTitle>Fantasy Manager Spel</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
    <MudGrid>
        <MudItem xs="12" Class="d-flex flex-column align-center">
            <MudText Typo="Typo.h2" Class="mb-4">Fantasy Manager Spel</MudText>
            <MudText Typo="Typo.h5" Class="mb-6">Skapa ditt fantasy fotbollslag och tävla med
                vänner!
            </MudText>

            <div class="d-flex gap-4 mb-8">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                           Href="/login">Logga in
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large"
                           Href="/register">Registrera
                </MudButton>
            </div>
        </MudItem>

        @if (Environment.IsDevelopment())
        {
            <MudItem xs="12" Class="d-flex flex-column align-center mb-6">
                <MudPaper Elevation="2" Class="pa-4"
                          Style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%); border: 1px solid #e94560;">
                    <MudText Typo="Typo.h6" Class="mb-3" Style="color: #e94560;">🔧 Debug Mode
                    </MudText>
                    <div class="d-flex gap-3">
                        <MudButton Variant="Variant.Filled"
                                   Style="background-color: #0f3460; color: white;"
                                   Size="Size.Large"
                                   OnClick="@(() => DebugLogin("manager1@test.com"))"
                                   Disabled="@_isLoggingIn">
                            @if (_isLoggingIn && _loggingInAs == "manager1@test.com")
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true"
                                                     Class="mr-2"/>
                            }
                            Manager 1 (Alpha)
                        </MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Style="background-color: #533483; color: white;"
                                   Size="Size.Large"
                                   OnClick="@(() => DebugLogin("manager2@test.com"))"
                                   Disabled="@_isLoggingIn">
                            @if (_isLoggingIn && _loggingInAs == "manager2@test.com")
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true"
                                                     Class="mr-2"/>
                            }
                            Manager 2 (Beta)
                        </MudButton>
                    </div>
                    <MudText Typo="Typo.caption" Class="mt-2" Style="color: #a0a0a0;">
                        Run with <code>seed</code> arg to create test data
                    </MudText>
                </MudPaper>
            </MudItem>
        }

        <MudItem xs="12" Class="mt-6">
            <MudPaper Elevation="3" Class="pa-6">
                <MudText Typo="Typo.h4" Class="mb-4">Hur man spelar</MudText>
                <MudList T="string">
                    <MudListItem T="string" Icon="@Icons.Material.Filled.PersonAdd">Skapa ett konto
                        eller logga in
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Add">Skapa en ny liga eller
                        gå med i en befintlig med en inbjudningskod
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Groups">Delta i
                        spelardraften för att bygga din trupp med 22 spelare
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.SportsFootball">Välj din
                        startelva för varje matchomgång
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.StarRate">Tjäna poäng
                        baserat på hur dina spelare presterar i verkliga matcher
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.EmojiEvents">Tävla i
                        slutspelsdraften efter gruppspelet
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Celebration">Vinn din liga
                        genom att samla flest poäng!
                    </MudListItem>
                </MudList>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private bool _isLoggingIn;
    private string? _loggingInAs;

    private async Task DebugLogin(string email)
    {
        _isLoggingIn = true;
        _loggingInAs = email;
        StateHasChanged();

        try
        {
            // Load managers to memory first since Email is a value object that can't be translated
            var managers = await DbContext.Managers
                .Include(m => m.Teams)
                .ToListAsync();

            var manager = managers.FirstOrDefault(m => m.Email.EmailAddress == email);

            if (manager is null)
            {
                Snackbar.Add("Manager not found. Run the app with 'seed' argument first.", Severity.Error);
                return;
            }

            await CurrentManager.SetManagerAsync(manager.Id);

            // Find the league the manager's team is in
            var team = manager.Teams.FirstOrDefault();
            if (team is not null)
            {
                NavigationManager.NavigateTo($"/league/{team.LeagueId}", true);
            }
            else
            {
                NavigationManager.NavigateTo("/dashboard", true);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Debug login failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoggingIn = false;
            _loggingInAs = null;
        }
    }
}
